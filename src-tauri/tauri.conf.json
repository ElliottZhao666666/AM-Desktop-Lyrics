{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMDL",
  "version": "0.1.0",
  "identifier": "com.crh38.tauri-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5566",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AM-Desktop-Lyrics",
        "width": 800,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false
      },
      {
        "label": "settings",
        "title": "AMDL 设置",
        "width": 920,
        "height": 700,
        "minWidth": 820,
        "minHeight": 620,
        "visible": false,
        "decorations": true,
        "resizable": false,
        "minimizable": true,
        "maximizable": false,
        "closable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
