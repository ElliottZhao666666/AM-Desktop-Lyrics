{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apple Music Desktop Lyrics",
  "mainBinaryName": "AMDL",
  "version": "1.0.0",
  "identifier": "com.crh38.tauri-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5566",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Apple Music Desktop Lyrics",
        "width": 800,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": true,
        "minWidth": 420,
        "minHeight": 100
      },
      {
        "label": "settings",
        "title": "AMDL 设置",
        "width": 1160,
        "height": 680,
        "minWidth": 1040,
        "minHeight": 580,
        "visible": false,
        "decorations": true,
        "resizable": false,
        "minimizable": true,
        "maximizable": false,
        "closable": true,
        "center": true
      },
      {
        "label": "unlock",
        "title": "解锁歌词窗口",
        "width": 44,
        "height": 40,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "月半菌",
    "homepage": "https://amdl.ybjun.com",
    "shortDescription": "Apple Music 桌面歌词工具",
    "longDescription": "为 Windows Apple Music 提供同步桌面歌词。",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
